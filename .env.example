# Copy the relevant mode file (for example .env.local) and customize it.
# Vite loads .env.<mode>[.local]

# Backend origin. Leave empty when the frontend and API share an origin.
VITE_API_URL=

# Google Cloud OAuth 2.0 Web client ID (public frontend identifier).
VITE_GOOGLE_CLIENT_ID=

# Allow authentification with fake tokens
VITE_ENABLE_FAKE_AUTH=
